Screen {
    layout: vertical;
    background: #111111;
    color: #d7d7d7;
}

#brand-panel {
    height: auto;
    padding: 1 2;
    color: #b9b3d9;
    background: #151515;
    border-bottom: solid #303030;
}

#prompt-info {
    layout: horizontal;
    height: 1;
    color: #9ca3af;
}

#conversation {
    height: 1fr;
    overflow-y: auto;
    padding: 1 2;
    background: #111111;
    scrollbar-color: #4a4a4a;
    scrollbar-color-hover: #6a6a6a;
}

#prompt-panel {
    height: auto;
    padding: 1 2;
    background: #151515;
    border-top: solid #303030;
}

#command-completion {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: #d1d5db;
    background: #181818;
    border: solid #365f5b;
}

#prompt-editor {
    height: 3;
    min-height: 3;
    max-height: 4;
    padding: 0 1;
    color: #e5e7eb;
    background: #111111;
    border: solid #3f3f46;
    overflow-x: hidden;
    overflow-y: auto;
}

#prompt-editor:focus {
    border: solid #5eead4;
}

#status {
    width: 1fr;
    height: 1;
    overflow-x: hidden;
}

#footer-model {
    width: auto;
    text-align: right;
}

.user-message {
    margin: 1 0 0 0;
    padding: 0 1;
    color: #d8b4fe;
    border-left: solid #a78bfa;
}

.system-notice {
    margin: 1 0 0 0;
    padding: 0 1;
    color: #9ca3af;
    border-left: solid #4b5563;
}

.assistant-turn {
    height: auto;
    margin: 1 0;
    padding: 0 1;
    color: #e5e7eb;
    border-left: solid #5eead4;
}

.thinking {
    margin-bottom: 1;
    padding: 0 1;
    color: #a3a3a3;
    background: #181818;
    border: solid #363636;
}

.thinking-body {
    color: #a3a3a3;
}

.tool-activities {
    width: 100%;
    height: auto;
}

.tool-activity {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    background: transparent;
    color: #b8d9d5;
    overflow: hidden;
}

.assistant-stream,
.assistant-markdown {
    width: 100%;
}

.assistant-markdown {
    background: #111111;
}

ModelPicker {
    align: center middle;
}

SessionPicker {
    align: center middle;
}

MemoryPicker, ConfirmationScreen {
    align: center middle;
}

PermissionSettingsScreen {
    align: center middle;
}

#model-picker-dialog {
    width: 80%;
    min-width: 40;
    max-width: 88;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #151515;
    border: solid #5eead4;
}

#session-picker-dialog {
    width: 80%;
    min-width: 40;
    max-width: 88;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #151515;
    border: solid #5eead4;
}

#memory-picker-dialog, #confirmation-dialog, #skill-install-dialog {
    width: 80%;
    min-width: 40;
    max-width: 88;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #151515;
    border: solid #5eead4;
}

.inline-choice-prompt {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    background: #151515;
    border-left: solid #e0a85c;
}

.plan-execution-prompt {
    border-left: solid #5eead4;
}

.mcp-trust-prompt {
    border-left: solid #f59e0b;
}

#permission-settings-dialog {
    width: 78%;
    min-width: 42;
    max-width: 90;
    height: auto;
    max-height: 86%;
    padding: 1 2;
    background: #151515;
    border: solid #5eead4;
}

#model-picker-title {
    height: 1;
    margin-bottom: 1;
    color: #e5e7eb;
    text-style: bold;
}

#session-picker-title {
    height: 1;
    margin-bottom: 1;
    color: #e5e7eb;
    text-style: bold;
}

#memory-picker-title, #confirmation-title, #skill-install-title {
    height: auto;
    margin-bottom: 1;
    color: #e5e7eb;
    text-style: bold;
}

#skill-install-details-scroll {
    height: auto;
    max-height: 20;
    margin-bottom: 1;
}

#skill-install-details {
    height: auto;
    color: #d1d5db;
}

#skill-install-options {
    height: auto;
    max-height: 8;
}

#skill-install-help {
    height: 1;
    margin-top: 1;
    color: #9ca3af;
}

.inline-choice-title {
    height: auto;
    color: #f3d3a2;
    text-style: bold;
}

.plan-execution-prompt .inline-choice-title {
    color: #b8eee7;
}

#permission-settings-title {
    height: 1;
    margin-bottom: 1;
    color: #b8eee7;
    text-style: bold;
}

.inline-choice-target,
.inline-choice-question,
.inline-choice-help {
    height: auto;
    color: #d1d5db;
}

.inline-choice-target,
.inline-choice-help {
    color: #9ca3af;
}

.inline-choice-options {
    height: auto;
    max-height: 6;
    margin: 0;
    color: #e5e7eb;
    background: transparent;
    border: none;
}

#permission-settings-options {
    height: auto;
    max-height: 8;
    margin-top: 1;
    color: #e5e7eb;
    background: #111111;
    border: solid #4a4a4a;
}

.permission-diagnostic {
    height: auto;
    color: #fca5a5;
}

.permission-warning {
    height: auto;
    color: #fcd34d;
}

#model-filter {
    height: 3;
    color: #e5e7eb;
    background: #111111;
    border: solid #3f3f46;
}

#model-filter:focus {
    border: solid #5eead4;
}

#memory-filter {
    height: 3;
    color: #e5e7eb;
    background: #111111;
    border: solid #3f3f46;
}

#memory-filter:focus {
    border: solid #5eead4;
}

#model-options {
    height: auto;
    max-height: 12;
    margin: 1 0;
    color: #d1d5db;
    background: #111111;
    border: solid #363636;
}

#session-options {
    height: auto;
    max-height: 12;
    margin: 1 0;
    color: #d1d5db;
    background: #111111;
    border: solid #363636;
}

#memory-options, #confirmation-options {
    height: auto;
    max-height: 12;
    margin: 1 0;
    color: #d1d5db;
    background: #111111;
    border: solid #363636;
}

#model-picker-empty {
    height: 1;
    margin-top: 1;
    color: #9ca3af;
}

#session-picker-empty {
    height: 1;
    margin-top: 1;
    color: #9ca3af;
}

#memory-picker-empty {
    height: 1;
    margin-top: 1;
    color: #9ca3af;
}
